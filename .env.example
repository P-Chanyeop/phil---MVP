# .env.example 을 .env 로 복사해서 쓰세요. .env 는 git 에 올라가지 않습니다.
# 에이전트(Claude Code)는 .env 를 읽을 수 없고, 키는 에이전트 프로세스에 전달되지 않습니다.

# ── 실거래 (선택) ───────────────────────────────────────────
# Polymarket 지갑 개인키. 실거래 전용으로 소액만 넣은 새 지갑을 쓰세요.
PHIL_PRIVATE_KEY=
# 서명 방식: 0 = 일반 EOA 지갑(MetaMask 등으로 직접 거래)
#           1 = Polymarket 이메일/매직링크 계정 (프록시 지갑)
#           2 = Polymarket 브라우저 지갑 계정 (Safe 프록시)
PHIL_SIGNATURE_TYPE=1
# 1 또는 2 일 때: polymarket.com 프로필에 표시되는 입금 주소(프록시 지갑 주소)
PHIL_FUNDER_ADDRESS=

# ── 휴대폰 접속 (선택) ───────────────────────────────────────
# python server.py --host 0.0.0.0 으로 열 때 필요한 접속 토큰 (12자 이상, 아무 문자열)
PHIL_WEB_TOKEN=
