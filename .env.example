# .env.example 을 .env 로 복사해서 쓰세요. .env 는 git 에 올라가지 않습니다.
# 에이전트(Claude)는 .env 를 읽을 수 없고, 아래 값은 에이전트 프로세스에 넘어가지 않습니다
# (ANTHROPIC_API_KEY 만 Claude 실행용으로 전달).

# ── Claude 로그인 (선택) ─────────────────────────────────────
# 비워 두면 이 PC/서버의 `claude` 구독 로그인을 씁니다 (가끔 만료 → claude → /login).
# API 키를 넣으면 만료 없이 사용한 만큼 결제됩니다: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── 한국투자증권 모의투자 계좌 (선택) ──────────────────────────
# KIS Developers(apiportal.koreainvestment.com)에서 '모의투자' 앱키를 발급받으세요.
# 계좌번호는 모의투자 계좌 10자리 (예: 50123456-01 또는 5012345601). 실계좌 주문은 지원하지 않습니다.
PHIL_KIS_APP_KEY=
PHIL_KIS_APP_SECRET=
PHIL_KIS_ACCOUNT=

# ── 휴대폰·외부 접속 (선택) ──────────────────────────────────
# python server.py --host 0.0.0.0 으로 열 때 필요한 접속 토큰 (12자 이상)
PHIL_WEB_TOKEN=
